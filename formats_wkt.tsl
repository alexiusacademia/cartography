// cartography: well-known text (WKT), "POINT (121 14.6)",
// "POLYGON ((0 0, 4 0, 4 4, 0 0))", …: one shape, or a file of them.
//
// Author: Alexius Academia
// Date: 2026-11-22

import geodesy

/// Reads WKT byte by byte. `ok` turns false at the first thing wrong.
struct FmtWktCursor {
    d: Data
    pos: Int = 0
    ok: Bool = true

    fn skipSpace() {
        let n = d.count
        while pos < n {
            let c = d[pos]
            if c == 32 || c == 10 || c == 13 || c == 9 {
                pos += 1
            } else {
                break
            }
        }
    }

    /// The next byte that isn't space (not passed), or -1 at the end.
    fn next() -> Int {
        skipSpace()
        if pos < d.count { d[pos] } else { -1 }
    }

    /// Passes `byte` if it's next; otherwise the text is wrong.
    fn expect(_ byte: Int) {
        if next() == byte {
            pos += 1
        } else {
            ok = false
            pos = d.count
        }
    }

    /// The letters at `pos`, in capitals.
    fn word() -> String {
        skipSpace()
        let start = pos
        let n = d.count
        while pos < n {
            let c = d[pos]
            if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
                pos += 1
            } else {
                break
            }
        }
        (d.slice(from: start, to: pos).text ?? "").uppercase()
    }

    /// Passes EMPTY if it's next.
    fn empty() -> Bool {
        let c = next()
        if c == 69 || c == 101 {
            let back = pos
            if word() == "EMPTY" {
                return true
            }
            pos = back
            ok = false
        }
        false
    }

    /// After an item of a list: passes a comma and gives true, or passes
    /// the closing parenthesis and gives false.
    fn more() -> Bool {
        let c = next()
        if c == 44 {
            pos += 1
            return true
        }
        if c == 41 {
            pos += 1
            return false
        }
        ok = false
        pos = d.count
        false
    }

    /// One point: "x y", with any more numbers (z, m) passed over. Adds
    /// x and y to `out`.
    fn point() -> (Float, Float) {
        var x = 0.0
        var y = 0.0
        var count = 0
        let n = d.count
        while pos < n {
            skipSpace()
            let start = pos
            while pos < n {
                let c = d[pos]
                if (c >= 48 && c <= 57) || c == 46 || c == 45 || c == 43 || c == 101 || c == 69 {
                    pos += 1
                } else {
                    break
                }
            }
            if pos == start {
                break
            }
            let v = fmtFloatAt(d, start, pos)
            if !v.isFinite {
                ok = false
            }
            if count == 0 {
                x = v
            } else if count == 1 {
                y = v
            }
            count += 1
        }
        if count < 2 {
            ok = false
            pos = d.count
        }
        (x, y)
    }

    /// "(x y, x y, …)" as x, y, x, y, …; also "((x y), (x y))", as the
    /// points of a MULTIPOINT may be written.
    fn points() -> [Float] {
        var out: [Float] = []
        expect(40)
        while ok {
            if next() == 40 {
                pos += 1
                let (x, y) = point()
                expect(41)
                out.append(x)
                out.append(y)
            } else if empty() {
                // "MULTIPOINT (EMPTY, 1 2)": nothing to add.
            } else {
                let (x, y) = point()
                out.append(x)
                out.append(y)
            }
            if !more() {
                break
            }
        }
        out
    }

    /// "((x y, …), (x y, …))": the rings of a polygon or the lines of a
    /// MULTILINESTRING.
    fn rings() -> [[Float]] {
        var out: [[Float]] = []
        expect(40)
        while ok {
            if !empty() {
                out.append(points())
            }
            if !more() {
                break
            }
        }
        out
    }

    /// A whole geometry: its name, then its coordinates or EMPTY.
    fn geometry() -> FmtShape {
        var shape = FmtShape()
        var name = word()
        // POINTZ, POINT Z, POINT ZM, …
        let dims = next()
        if dims == 90 || dims == 122 || dims == 77 || dims == 109 {
            let back = pos
            let w = word()
            if w != "Z" && w != "M" && w != "ZM" {
                pos = back
            }
        } else if name.hasSuffix("ZM") && name.count > 4 {
            name = name.substring(from: 0, to: name.count - 2)
        } else if (name.hasSuffix("Z") || name.hasSuffix("M")) && name.count > 4 {
            name = name.substring(from: 0, to: name.count - 1)
        }
        if name == "POINT" || name == "MULTIPOINT" {
            shape.hint = 0
            if !empty() && ok {
                shape.addPoints(points())
            }
        } else if name == "LINESTRING" || name == "LINEARRING" {
            shape.hint = 1
            if !empty() && ok {
                shape.addLine(points())
            }
        } else if name == "MULTILINESTRING" {
            shape.hint = 1
            if !empty() && ok {
                for line in rings() {
                    shape.addLine(line)
                }
            }
        } else if name == "POLYGON" {
            shape.hint = 2
            if !empty() && ok {
                shape.addPolygon(rings())
            }
        } else if name == "MULTIPOLYGON" {
            shape.hint = 2
            if !empty() && ok {
                expect(40)
                while ok {
                    if !empty() {
                        shape.addPolygon(rings())
                    }
                    if !more() {
                        break
                    }
                }
            }
        } else if name == "GEOMETRYCOLLECTION" {
            if !empty() && ok {
                expect(40)
                while ok {
                    shape.merge(geometry())
                    if !more() {
                        break
                    }
                }
            }
        } else {
            ok = false
            pos = d.count
        }
        shape
    }
}

struct FmtWktFound {
    shape: FmtShape
    srid: Int = 0
}

/// The shapes written in WKT (of any kinds), and the number after `SRID=`
/// if the text starts with one (0 otherwise); nil if it isn't WKT.
fn fmtWktShape(_ d: Data) -> FmtWktFound? {
    var p = FmtWktCursor(d: d)
    var srid = 0
    let first = p.next()
    if first == 83 || first == 115 {
        // SRID=4326;POINT (…)
        if p.word() != "SRID" {
            return nil
        }
        p.expect(61)
        p.skipSpace()
        let start = p.pos
        while p.pos < d.count && d[p.pos] >= 48 && d[p.pos] <= 57 {
            p.pos += 1
        }
        srid = Int(d.slice(from: start, to: p.pos).text ?? "") ?? 0
        p.expect(59)
    }
    let shape = p.geometry()
    if !p.ok || p.next() >= 0 {
        return nil
    }
    FmtWktFound(shape: shape, srid: srid)
}

/// The geometry written as WKT ("POINT (121 14.6)", "MULTIPOLYGON (…)",
/// also with Z or M, which are dropped, and after "SRID=…;"). A
/// GEOMETRYCOLLECTION gives its members of the kind of its first one;
/// `EMPTY` gives an empty geometry.
public fn geometryFromWkt(_ text: String) -> Result<Geometry> {
    if let found = fmtWktShape(Data(text: text)) {
        let shape = found.shape
        if shape.first >= 0 {
            return .ok(value: shape.geometry(shape.first))
        }
        return .ok(value: emptyGeometry(fmtKind(max(shape.hint, 0))))
    }
    let t = text.trim()
    let shown = if t.count > 40 { t.substring(from: 0, to: 40) + "…" } else { t }
    Result.failure(error: Error("\"{shown}\" isn't WKT"))
}

fn fmtWktPoints(_ coords: [Float], _ decimals: Int) -> String {
    var out: [String] = []
    var i = 0
    while i + 1 < coords.count {
        out.append(fmtWktNumber(coords[i], decimals) + " " + fmtWktNumber(coords[i + 1], decimals))
        i += 2
    }
    "(" + out.joined(separator: ", ") + ")"
}

/// A coordinate with up to `decimals` digits; with 16 or more, as exact
/// as the number is.
fn fmtWktNumber(_ x: Float, _ decimals: Int) -> String {
    if decimals > 15 { fmtShort(x) } else { fmtNum(x, decimals) }
}

fn fmtWktRings(_ rings: [[Float]], _ decimals: Int) -> String {
    "(" + rings.map { r in fmtWktPoints(r, decimals) }.joined(separator: ", ") + ")"
}

/// The geometry as WKT, with up to `decimals` digits after the point
/// (16 or more, as by default: every digit the numbers have, so the text
/// reads back as the same numbers). A shape of several members is a
/// MULTIPOINT, MULTILINESTRING or MULTIPOLYGON.
public fn wkt(_ g: Geometry, decimals: Int = 17) -> String {
    match g.kind {
        .point -> {
            if g.isEmpty() {
                return "POINT EMPTY"
            }
            var coords: [Float] = []
            for p in g.parts {
                coords.appendAll(p)
            }
            if coords.count == 2 {
                return "POINT " + fmtWktPoints(coords, decimals)
            }
            var points: [String] = []
            var i = 0
            while i + 1 < coords.count {
                points.append(fmtWktPoints([coords[i], coords[i + 1]], decimals))
                i += 2
            }
            return "MULTIPOINT (" + points.joined(separator: ", ") + ")"
        }
        .line -> {
            if g.isEmpty() {
                return "LINESTRING EMPTY"
            }
            if g.parts.count == 1 {
                return "LINESTRING " + fmtWktPoints(g.parts[0], decimals)
            }
            return "MULTILINESTRING " + fmtWktRings(g.parts, decimals)
        }
        .polygon -> {
            if g.isEmpty() {
                return "POLYGON EMPTY"
            }
            if g.polygons.count == 1 {
                return "POLYGON " + fmtWktRings(g.rings(of: 0), decimals)
            }
            var polygons: [String] = []
            for i in 0..g.polygons.count {
                polygons.append(fmtWktRings(g.rings(of: i), decimals))
            }
            return "MULTIPOLYGON (" + polygons.joined(separator: ", ") + ")"
        }
    }
}

/// Reads text with a WKT geometry on each line (empty lines and lines
/// starting with # are passed over) as layers, one for each kind of shape
/// there is, called `name`. A first line starting with `SRID=…;` says the
/// CRS (an EPSG code); otherwise it's `crs`.
public fn readWKT(_ text: String, name: String = "", crs: geodesy.Crs = lonLat()) -> Result<[Layer]> {
    fmtWktLines(Data(text: text), label: fmtLabel(name), name: name, source: "", crs: crs)
}

/// The layers of a file of WKT lines (see `readWKT`).
fn fmtWktLines(_ d: Data, label: String, name: String, source: String, crs: geodesy.Crs) -> Result<[Layer]> {
    let path = label
    var crs = crs
    var build = FmtBuilder()
    var pos = 0
    if d.count >= 3 && d[0] == 239 && d[1] == 187 && d[2] == 191 {
        pos = 3
    }
    let n = d.count
    var line = 0
    while pos < n {
        var end = pos
        while end < n && d[end] != 10 && d[end] != 13 {
            end += 1
        }
        line += 1
        var from = pos
        while from < end && (d[from] == 32 || d[from] == 9) {
            from += 1
        }
        if from < end && d[from] != 35 {
            if let found = fmtWktShape(d.slice(from: from, to: end)) {
                if found.srid > 0 && build.count() == 0 {
                    crs = geodesy.epsg(found.srid) ?? crs
                }
                build.add(found.shape)
            } else {
                return .failure(error: fmtReadError(path, "line {line} isn't WKT"))
            }
        }
        pos = end + 1
        if end < n && d[end] == 13 && pos < n && d[pos] == 10 {
            pos += 1
        }
    }
    Result.ok(value: build.layers(name: name, source: source, crs: crs, columns: []))
}

/// The geometry of each feature as a line of WKT, in the layer's CRS
/// (named with `SRID=…;` before each geometry when it has an EPSG code
/// other than 4326), with every digit. Attributes aren't written.
public fn wktLines(_ layer: Layer) -> String {
    var out: [String] = []
    let prefix = if layer.crs.code > 0 && layer.crs.code != 4326 { "SRID={layer.crs.code};" } else { "" }
    for g in layer.geoms {
        out.append(prefix + wkt(g) + "\n")
    }
    out.joined()
}
