// cartography's raster tests: reading GeoTIFF of every kind, ASCII grids,
// SRTM and pictures with world files, checked against what GDAL reads in
// the same files (tests/data/raster/expected.json, made with the fixtures
// by tools/oracle/raster_fixtures.py); terrain against gdaldem; contours
// against contourpy; writers by reading back; rendering and warping.
//
// Author: Alexius Academia
// Date: 2026-11-22

import ".."
import geodesy

// What GDAL read in one band of a fixture (no-data cells left out).
struct RasTBand {
    count: Int
    sum: Float
    weighted: Float
    low: Float
    high: Float
    first: [Float]
}

// What GDAL read in one fixture.
struct RasTFile {
    file: String
    width: Int
    height: Int
    minX: Float
    maxY: Float
    cellX: Float
    cellY: Float
    epsg: Int
    hasNoData: Bool
    noData: Float
    centerLon: Float
    centerLat: Float
    bands: [RasTBand]
}

// One contour level as contourpy draws it.
struct RasTLevel {
    level: Float
    lines: Int
    closed: Int
    length: Float
}

struct RasTExpected {
    files: [RasTFile]
    contours: [RasTLevel]
}

// The folder of the fixtures, from the library's folder or the tests'.
fn rasTFolder() -> String {
    if fileExists("tests/data/raster/expected.json") {
        return "tests/data/raster"
    }
    "data/raster"
}

fn rasTPath(_ name: String) -> String {
    joinPath(rasTFolder(), name)
}

fn rasTExpected() -> RasTExpected {
    match readText(rasTPath("expected.json")) {
        .ok(text) -> {
            if let e: RasTExpected = fromJson(text) {
                return e
            }
            fail("expected.json doesn't read")
        }
        .failure(e) -> fail(e.message)
    }
    RasTExpected(files: [], contours: [])
}

fn rasTEntry(_ name: String) -> RasTFile? {
    for f in rasTExpected().files {
        if f.file == name {
            return f
        }
    }
    nil
}

// The entry of a fixture; the test fails without one.
fn rasTMust(_ name: String) -> RasTFile {
    if let e = rasTEntry(name) {
        return e
    }
    fail("{name} isn't in expected.json")
    RasTFile(file: name, width: 0, height: 0, minX: 0.0, maxY: 0.0, cellX: 0.0, cellY: 0.0, epsg: 0, hasNoData: false,
             noData: 0.0, centerLon: 0.0, centerLat: 0.0, bands: [])
}

fn rasTRead(_ name: String) -> cartography.Layer {
    match cartography.readRaster(rasTPath(name)) {
        .ok(layer) -> layer
        .failure(e) -> {
            fail("{name}: {e.message}")
            cartography.Layer()
        }
    }
}

fn rasTClose(_ a: Float, _ b: Float, _ tol: Float) -> Bool {
    abs(a - b) <= tol * max(1.0, max(abs(a), abs(b)))
}

// Reads a fixture and checks it against what GDAL read in it: size,
// place, CRS, no-data, and every band's values (count, sum, a weighted
// sum that depends on where each value is, extremes, the first values).
fn rasTCheck(_ name: String, crsTolerance: Float = 0.0000001) {
    let e = rasTMust(name)
    let layer = rasTRead(name)
    let r = layer.raster
    expect(layer.kind == cartography.LayerKind.raster, "{name}: kind")
    expect(r.width == e.width, "{name}: width")
    expect(r.height == e.height, "{name}: height")
    expect(rasTClose(r.box.minX, e.minX, 0.000000000001), "{name}: left {r.box.minX} vs {e.minX}")
    expect(rasTClose(r.box.maxY, e.maxY, 0.000000000001), "{name}: top {r.box.maxY} vs {e.maxY}")
    let (cx, cy) = cartography.rasterCellSize(r)
    expect(rasTClose(cx, e.cellX, 0.000000001), "{name}: cell width {cx} vs {e.cellX}")
    expect(rasTClose(cy, e.cellY, 0.000000001), "{name}: cell height {cy} vs {e.cellY}")
    if e.epsg != 0 && e.epsg != 25395 && !name.hasSuffix(".asc") {
        expect(layer.crs.code == e.epsg, "{name}: EPSG {layer.crs.code} vs {e.epsg}")
    }
    let (lon, lat) = layer.crs.toWGS84(r.box.centerX(), r.box.centerY())
    expect(abs(lon - e.centerLon) <= crsTolerance, "{name}: center longitude {lon} vs {e.centerLon}")
    expect(abs(lat - e.centerLat) <= crsTolerance, "{name}: center latitude {lat} vs {e.centerLat}")
    if e.hasNoData {
        expect(r.noData == e.noData, "{name}: no-data {r.noData} vs {e.noData}")
    }
    expect(r.bands.count == e.bands.count, "{name}: {r.bands.count} bands vs {e.bands.count}")
    if r.bands.count != e.bands.count {
        return
    }
    for (b, eb) in e.bands.enumerated() {
        var count = 0
        var sum = 0.0
        var weighted = 0.0
        let band = r.bands[b]
        expect(band.count == r.width * r.height, "{name}: band {b} has {band.count} cells")
        for (i, v) in band.enumerated() {
            if v.isFinite {
                count += 1
                sum += v
                weighted += v * Float(i % 97 + 1)
            }
        }
        expect(count == eb.count, "{name}: band {b}: {count} cells with values vs {eb.count}")
        expect(rasTClose(sum, eb.sum, 0.000000000001), "{name}: band {b}: sum {sum} vs {eb.sum}")
        expect(rasTClose(weighted, eb.weighted, 0.000000000001), "{name}: band {b}: weighted sum {weighted} vs {eb.weighted}")
        expect(r.lows[b] == eb.low, "{name}: band {b}: low {r.lows[b]} vs {eb.low}")
        expect(r.highs[b] == eb.high, "{name}: band {b}: high {r.highs[b]} vs {eb.high}")
        for (k, v) in eb.first.enumerated() {
            if v < -1.0e299 {
                expect(band[k].isNaN, "{name}: band {b}: cell {k} should have no value")
            } else {
                expect(band[k] == v, "{name}: band {b}: cell {k} is {band[k]} vs {v}")
            }
        }
    }
}

// ----- GeoTIFF: types, packings, layouts -----

test "GeoTIFF uint8, no packing, strips" { rasTCheck("u8_none_strip.tif") }
test "GeoTIFF uint8, LZW, strips" { rasTCheck("u8_lzw_strip.tif") }
test "GeoTIFF uint8, LZW, predictor 2" { rasTCheck("u8_lzw_pred2.tif") }
test "GeoTIFF uint8, Deflate, tiles" { rasTCheck("u8_deflate_tile.tif") }
test "GeoTIFF uint8, PackBits" { rasTCheck("u8_packbits.tif") }
test "GeoTIFF int8, Deflate" { rasTCheck("i8_deflate.tif") }
test "GeoTIFF uint16, LZW, predictor 2, tiles" { rasTCheck("u16_lzw_pred2_tile.tif") }
test "GeoTIFF uint16, big-endian" { rasTCheck("u16_none_big.tif") }
test "GeoTIFF int16, Deflate, predictor 2" { rasTCheck("i16_deflate_pred2.tif") }
test "GeoTIFF int16, PackBits" { rasTCheck("i16_packbits.tif") }
test "GeoTIFF int16, LZW, predictor 2, big-endian" { rasTCheck("i16_lzw_big_pred2.tif") }
test "GeoTIFF uint32, Deflate" { rasTCheck("u32_deflate.tif") }
test "GeoTIFF int32, LZW, predictor 2" { rasTCheck("i32_lzw_pred2.tif") }
test "GeoTIFF float32, no packing" { rasTCheck("f32_none.tif") }
test "GeoTIFF float32, LZW, predictor 3" { rasTCheck("f32_lzw_pred3.tif") }
test "GeoTIFF float32, Deflate, predictor 3, tiles" { rasTCheck("f32_deflate_pred3_tile.tif") }
test "GeoTIFF float32, Deflate, predictor 2" { rasTCheck("f32_deflate_pred2.tif") }
test "GeoTIFF float32, LZW, predictor 3, big-endian" { rasTCheck("f32_lzw_big_pred3.tif") }
test "GeoTIFF float32, PackBits, tiles" { rasTCheck("f32_packbits_tile.tif") }
test "GeoTIFF float64, Deflate, predictor 3" { rasTCheck("f64_deflate_pred3.tif") }
test "GeoTIFF float64, tiles" { rasTCheck("f64_none_tile.tif") }
test "GeoTIFF RGB, pixel-interleaved, LZW" { rasTCheck("rgb_pixel_lzw.tif") }
test "GeoTIFF RGB, band-interleaved, Deflate, tiles" { rasTCheck("rgb_band_deflate_tile.tif") }
