    fmtTCheck("several.gpkg", layer: "cities")
    fmtTCheck("several.gpkg", layer: "roads")
    fmtTCheck("several.gpkg", layer: "zones")
    let layers = cartography.readGeoPackage(fmtTPath("several.gpkg")).valueOr([])
    expect(layers.map { l in l.name } == ["cities", "roads", "zones"])
}

