    fmtTCheck("countries.gpkg")
}

test "KML points" {
    fmtTCheck("points.kml")
    // GDAL's KML reader leaves out ExtendedData: these are the values written.
    let layer = cartography.readLayers(fmtTPath("points.kml")).valueOr([])[0]
    expect(layer.fieldNames() == ["name", "description", "id", "value", "count"])
    expect(layer.columns[2].kind == .int && layer.columns[2].nums == [1, 2, 3, 4, 5])
    expect(layer.columns[3].kind == .float && layer.columns[3].number(3) == 123456.789 && layer.columns[3].isNull(4))
    expect(layer.columns[3].number(2) == 1e-7)
    expect(layer.columns[0].display(2) == "Tour Eiffel \"Zoë\"")
}

test "KML lines" {
    fmtTCheck("lines.kml")
}

test "KML polygons" {
