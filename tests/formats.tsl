// Tests of cartography's file formats. The files in data/formats were
// written by GDAL (tools/oracle/formats_fixtures.py), which also wrote
// what it reads from each into expected.json: these tests read the files
// with cartography and compare. Round trips write every format and read
// it back; damaged and odd input must give an error, never a crash.
// tools/oracle/formats_check_written.py has GDAL read the files
// cartography writes (from the test "files are written for the oracle").
//
// Author: Alexius Academia
// Date: 2026-11-22

import ".." as cartography
import geodesy

/// What GDAL read from one layer of a fixture.
struct FmtTExpected {
    file: String
    layer: String
    kind: String
    epsg: Int
    count: Int
    fields: [String]
    kinds: [String]
    rows: [[String?]]
    wkts: [String]
}

/// The folder of the fixtures, whether the tests run from the library's
/// folder or from tests/.
fn fmtTFolder() -> String {
    if fileExists("tests/data/formats/expected.json") {
        return "tests/data/formats"
    }
    "data/formats"
}

/// Fails the test if writing gave an error.
fn fmtTOk(_ e: Error?, _ what: String = "") {
    if let err = e {
        fail("{what}: {err.message}")
    }
}

fn fmtTPath(_ file: String) -> String {
    joinPath(fmtTFolder(), file)
}

/// A new, empty folder for files written by a test.
fn fmtTOut(_ name: String) -> String {
    let folder = joinPath(tempFolder(), "cartography-formats-" + name + "-{Int(now() * 1000.0) % 100000000}")
    createFolder(folder)
    folder
}

fn fmtTExpectations() -> [FmtTExpected] {
    let text = readFile(fmtTPath("expected.json")) ?? "[]"
    let r: Result<[FmtTExpected]> = decodeJson(text)
    r.valueOr([])
}

fn fmtTKindName(_ k: cartography.GeomKind) -> String {
    match k {
        .point -> "point"
        .line -> "line"
        .polygon -> "polygon"
    }
}

/// Are two numbers the same, but for the last bits?
fn fmtTClose(_ a: Float, _ b: Float, _ tolerance: Float = 1e-9) -> Bool {
    if a.isNaN || b.isNaN {
        return a.isNaN && b.isNaN
    }
    abs(a - b) <= tolerance * max(1.0, max(abs(a), abs(b)))
}

/// A ring told apart from the others whatever its direction and first
/// point: its area, its points and the corner of its box.
fn fmtTRingSign(_ ring: [Float]) -> [Float] {
    var minX = 1.0 / 0.0
    var minY = 1.0 / 0.0
    var i = 0
    while i + 1 < ring.count {
        minX = min(minX, ring[i])
        minY = min(minY, ring[i + 1])
        i += 2
    }
    [abs(cartography.ringArea2(ring)), Float(ring.count), minX, minY]
}

/// Do two shapes have the same points (polygons: the same rings, whatever
/// their direction and order)? Says what differs, or "".
fn fmtTShapeDiff(_ a: cartography.Geometry, _ b: cartography.Geometry, tolerance: Float = 1e-9) -> String {
    if a.isEmpty() || b.isEmpty() {
        return if a.isEmpty() == b.isEmpty() { "" } else { "one is empty" }
    }
    if a.kind != b.kind {
        return "kinds {fmtTKindName(a.kind)} and {fmtTKindName(b.kind)}"
    }
    if a.kind == .polygon {
        if a.polygons.count != b.polygons.count || a.parts.count != b.parts.count {
            return "{a.polygons.count} polygons of {a.parts.count} rings, and {b.polygons.count} of {b.parts.count}"
        }
        var signs = b.parts.map { r in fmtTRingSign(r) }
        for r in a.parts {
            let s = fmtTRingSign(r)
            var found = -1
            for (k, t) in signs.enumerated() {
                if fmtTClose(s[0], t[0], tolerance) && s[1] == t[1] && fmtTClose(s[2], t[2], tolerance) && fmtTClose(s[3], t[3], tolerance) {
                    found = k
                    break
                }
            }
            if found < 0 {
                return "a ring of {Int(s[1]) / 2} points at {s[2]}, {s[3]} isn't in the other"
            }
            signs.remove(at: found)
        }
        return ""
    }
    if a.parts.count != b.parts.count && a.kind == .line {
        return "{a.parts.count} lines and {b.parts.count}"
    }
    var pa: [Float] = []
    var pb: [Float] = []
    for p in a.parts {
        pa += p
    }
    for p in b.parts {
        pb += p
    }
    if pa.count != pb.count {
        return "{pa.count / 2} points and {pb.count / 2}"
    }
    for i in 0..pa.count {
        if !fmtTClose(pa[i], pb[i], tolerance) {
            return "coordinate {i}: {pa[i]} and {pb[i]}"
        }
    }
    ""
}

/// The layer of a file that GDAL's layer `e` is.
fn fmtTFind(_ layers: [cartography.Layer], _ e: FmtTExpected) -> cartography.Layer? {
    if layers.count == 1 {
        return layers[0]
    }
    for l in layers {
        if l.name == e.layer || l.name.hasSuffix("(" + e.layer + ")") {
            return l
        }
    }
    for l in layers {
        if fmtTKindName(l.geomKind) == e.kind {
            return l
        }
    }
    nil
}

/// Compares a layer read by cartography with what GDAL read. Fields
/// GDAL has that the layer hasn't are left out when they're in `skip`.
fn fmtTCompare(_ layer: cartography.Layer, _ e: FmtTExpected, skip: [String] = [], tolerance: Float = 0.0) {
    expect(layer.geoms.count == e.count, "{e.file}: features")
    expect(fmtTKindName(layer.geomKind) == e.kind, "{e.file}: kind")
    if e.epsg > 0 {
        if let c = geodesy.epsg(e.epsg) {
            expect(cartography.sameCrs(layer.crs, c), "{e.file}: CRS {layer.crs.name} isn't EPSG:{e.epsg}")
        }
    }
    let n = min(layer.geoms.count, e.count)
    for r in 0..n {
        let want = if e.wkts[r].isEmpty { cartography.emptyGeometry(layer.geomKind) } else {
            cartography.geometryFromWkt(e.wkts[r]).valueOr(cartography.emptyGeometry(.point))
        }
        let diff = fmtTShapeDiff(layer.geoms[r], want, tolerance: tolerance)
        expect(diff.isEmpty, "{e.file} row {r}: {diff}")
    }
    for (f, name) in e.fields.enumerated() {
        if skip.contains(name) {
            continue
        }
        if let c = layer.columnIndex(name) {
            let col = layer.columns[c]
            for r in 0..n {
                let want = e.rows[r][f] ?? ""
                if col.isNumeric() && e.kinds[f] != "text" {
                    let x = Float(want) ?? (0.0 / 0.0)
                    expect(fmtTClose(col.number(r), x, 1e-12), "{e.file} {name} row {r}: {col.display(r)}, not {want}")
                } else if col.isNumeric() {
                    // GDAL read it as text (CSV): the same number.
                    let x = Float(want.trim()) ?? (0.0 / 0.0)
                    expect(fmtTClose(col.number(r), x, 1e-12), "{e.file} {name} row {r}: {col.display(r)}, not {want}")
                } else {
                    expect(col.display(r) == want, "{e.file} {name} row {r}: \"{col.display(r)}\", not \"{want}\"")
                }
            }
        } else {
            fail("{e.file}: no column {name}")
        }
    }
}

/// Reads a fixture with cartography (`readLayers`) and compares it with
/// what GDAL read from it.
fn fmtTCheck(_ file: String, layer: String = "", skip: [String] = []) {
    let all = fmtTExpectations()
    expect(!all.isEmpty, "expected.json is missing")
    var found = false
    for e in all {
        if e.file != file || (!layer.isEmpty && e.layer != layer) {
            continue
        }
        found = true
        match cartography.readLayers(fmtTPath(file)) {
            .ok(layers) -> {
                if let l = fmtTFind(layers, e) {
                    expect(l.source == fmtTPath(file))
                    fmtTCompare(l, e, skip: skip)
                } else {
                    fail("{file}: no layer like {e.layer}")
                }
            }
            .failure(err) -> fail("{file}: {err.message}")
        }
    }
    expect(found, "{file} isn't in expected.json")
}

