// cartography: basemap tiles. The square pictures web maps are made of,
// where they come from (sources anyone may use without a key, any XYZ
// address, a WMS), and their maths: which tiles a map shows, at which zoom,
// and the address of each.
//
// The world in Web Mercator (EPSG:3857) is a square 2 × `tileWorldHalf()`
// meters wide. At zoom z it's cut into 2^z × 2^z tiles, usually of 256
// pixels; tile (0, 0) is the top left one (the north-west corner).
//
// Fetching tiles (tiles_fetch.tsl) and drawing and warping them
// (tiles_draw.tsl) are in files of their own.
//
// Author: Alexius Academia
// Date: 2026-11-22

import geodesy

/// Half the width of the Web Mercator world, in meters: x and y run from
/// minus this to this.
public fn tileWorldHalf() -> Float {
    20037508.342789244
}

/// One tile: its zoom `z`, its column `x` (from the left, 0 to 2^z − 1)
/// and its row `y` (from the top).
public struct Tile {
    z: Int = 0
    x: Int = 0
    y: Int = 0
    /// Where it's drawn, counted in tiles from the left edge of the world:
    /// the same as `x`, or a whole world further left or right where a map
    /// shows the world more than once (or across the 180° meridian).
    column: Int = 0

    /// "z/x/y", the tile's place in the cache.
    fn key() -> String {
        "{z}/{x}/{y}"
    }

    /// The part of the map the tile covers, in Web Mercator (at `column`).
    fn box() -> Box {
        let size = 2.0 * tileWorldHalf() / tileCount(z)
        let minX = -tileWorldHalf() + Float(column) * size
        let maxY = tileWorldHalf() - Float(y) * size
        boxOf(minX: minX, minY: maxY - size, maxX: minX + size, maxY: maxY)
    }

    /// The tile one zoom out that this one is a quarter of.
    fn parent() -> Tile {
        Tile(z: z - 1, x: x >> 1, y: y >> 1, column: column >> 1)
    }

    /// The tile `levels` zooms out that this one is part of.
    fn ancestor(_ levels: Int) -> Tile {
        Tile(z: z - levels, x: x >> levels, y: y >> levels, column: column >> levels)
    }

    /// The four tiles one zoom in: top left, top right, bottom left,
    /// bottom right.
    fn children() -> [Tile] {
        let x2 = x * 2
        let y2 = y * 2
        let c2 = column * 2
        [
            Tile(z: z + 1, x: x2, y: y2, column: c2),
            Tile(z: z + 1, x: x2 + 1, y: y2, column: c2 + 1),
            Tile(z: z + 1, x: x2, y: y2 + 1, column: c2),
            Tile(z: z + 1, x: x2 + 1, y: y2 + 1, column: c2 + 1),
        ]
    }

    /// The row counted from the bottom, as TMS servers number them.
    fn tmsY() -> Int {
        (1 << z) - 1 - y
    }

    /// The tile's quadkey (Bing's way of naming tiles): one digit 0 to 3
    /// for each zoom ("" at zoom 0).
    fn quadkey() -> String {
        var out = ""
        var i = z
        while i > 0 {
            let mask = 1 << (i - 1)
            var digit = 0
            if x & mask != 0 {
                digit += 1
            }
            if y & mask != 0 {
                digit += 2
            }
            out += "{digit}"
            i -= 1
        }
        out
    }
}

/// How many tiles across the world is at zoom `z` (2^z).
public fn tileCount(_ z: Int) -> Float {
    pow(2.0, Float(z))
}

/// The tile of zoom `zoom` with a place in it (longitude and latitude in
/// degrees, WGS84). Latitudes beyond about ±85.05° give the top or bottom row.
public fn tileAt(lon: Float, lat: Float, zoom: Int) -> Tile {
    let (tx, ty) = tileUnits(lon: lon, lat: lat, zoom: zoom)
    let n = 1 << zoom
    let x = Int(floor(tx)).clamped(min: 0, max: n - 1)
    let y = Int(floor(ty)).clamped(min: 0, max: n - 1)
    Tile(z: zoom, x: x, y: y, column: x)
}

/// Where a place (longitude, latitude in degrees) is on the tiles of zoom
/// `zoom`, in tiles from the top left corner of the world: the whole parts
/// are the tile's column and row, the fractions the place inside it.
public fn tileUnits(lon: Float, lat: Float, zoom: Int) -> (Float, Float) {
    let n = tileCount(zoom)
    let phi = lat.clamped(min: -89.9999, max: 89.9999) * pi / 180.0
    let x = (lon + 180.0) / 360.0 * n
    let y = (1.0 - log(tan(phi) + 1.0 / cos(phi)) / pi) / 2.0 * n
    (x, y)
}

/// Where a Web Mercator point is on the tiles of zoom `zoom`, in tiles from
/// the top left corner of the world (see `tileUnits`).
public fn tileUnitsOf(x: Float, y: Float, zoom: Int) -> (Float, Float) {
    let n = tileCount(zoom)
    let w = 2.0 * tileWorldHalf()
    ((x + tileWorldHalf()) / w * n, (tileWorldHalf() - y) / w * n)
}

/// The zoom whose tile pixels come closest to one point each on a map
/// showing `metersPerPoint` Web Mercator meters in one point, within
/// `minZoom` and `maxZoom`. (A little before half way it takes the zoom
/// further in, so tiles are rather sharp than soft.)
public fn tileZoomFor(metersPerPoint: Float, minZoom: Int = 0, maxZoom: Int = 19) -> Int {
    if !(metersPerPoint > 0.0) || !metersPerPoint.isFinite {
        return minZoom
    }
    let z = log(156543.03392804097 / metersPerPoint) / log(2.0)
    Int(floor(z + 0.6)).clamped(min: minZoom, max: maxZoom)
}

/// The tiles of zoom `zoom` that touch a box in Web Mercator, row by row
/// from the top. Columns beyond the world's edges are given with `x`
/// wrapped round (and `column` as it is). None at all if there would be
/// more than `limit`.
public fn tilesIn(_ box: Box, zoom: Int, limit: Int = 400) -> [Tile] {
    if box.empty {
        return []
    }
    let (fx0, fy0) = tileUnitsOf(x: box.minX, y: box.maxY, zoom: zoom)
    let (fx1, fy1) = tileUnitsOf(x: box.maxX, y: box.minY, zoom: zoom)
    tileRange(fx0, fy0, fx1, fy1, zoom: zoom, limit: limit)
}

// The tiles between two corners given in tile units (columns unwrapped).
private fn tileRange(_ fx0: Float, _ fy0: Float, _ fx1: Float, _ fy1: Float, zoom: Int, limit: Int) -> [Tile] {
    if !(fx0.isFinite && fy0.isFinite && fx1.isFinite && fy1.isFinite) {
        return []
    }
    let n = 1 << zoom
    // (A tile whose edge the box only touches isn't wanted.)
    let tiny = 0.000000001
    let x0 = Int(floor(min(fx0, fx1) + tiny))
    let x1 = max(x0, Int(ceil(max(fx0, fx1) - tiny)) - 1)
    let y0 = Int(floor(min(fy0, fy1) + tiny)).clamped(min: 0, max: n - 1)
    let y1 = max(y0, Int(ceil(max(fy0, fy1) - tiny)) - 1).clamped(min: 0, max: n - 1)
    // (More columns than the world has would show it twice over.)
    if x1 - x0 + 1 > n * 3 {
        return []
    }
    if (x1 - x0 + 1) * (y1 - y0 + 1) > limit {
        return []
    }
    var out: [Tile] = []
    for y in y0..(y1 + 1) {
        for x in x0..(x1 + 1) {
            out.append(Tile(z: zoom, x: ((x % n) + n) % n, y: y, column: x))
        }
    }
    out
}

/// The zoom of a tile layer's tiles for what a map shows now: tile pixels
/// about as large as the Canvas's points, within the layer's zooms. In a
/// map that isn't in Web Mercator, it goes by the scale in the middle.
public fn tileZoom(_ m: Map, _ layer: Layer) -> Int {
    let lo = max(layer.minZoom, 0)
    let hi = max(layer.maxZoom, lo)
    if isWebMercator(m.crs) {
        return tileZoomFor(metersPerPoint: 1.0 / max(m.vp.scale, 0.000000000001), minZoom: lo, maxZoom: hi)
    }
    // Web Mercator meters across one point, at the middle of the map.
    let mercator = webMercator()
    let d = 1.0 / max(m.vp.scale, 0.000000000001)
    let cx = m.vp.centerX
    let cy = m.vp.centerY
    let (ax, ay) = geodesy.transform(cx - d / 2.0, cy, from: m.crs, to: mercator)
    let (bx, by) = geodesy.transform(cx + d / 2.0, cy, from: m.crs, to: mercator)
    let (px, py) = geodesy.transform(cx, cy - d / 2.0, from: m.crs, to: mercator)
    let (qx, qy) = geodesy.transform(cx, cy + d / 2.0, from: m.crs, to: mercator)
    let across = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
    let up = sqrt((qx - px) * (qx - px) + (qy - py) * (qy - py))
    let meters = max(across, up)
    if !meters.isFinite || meters <= 0.0 {
        return lo
    }
    tileZoomFor(metersPerPoint: meters, minZoom: lo, maxZoom: hi)
}

/// The tiles of a tile layer that cover what a map shows, at `tileZoom`
/// (or zooms further out, when that would take more than `limit` tiles).
/// In a map that isn't in Web Mercator, what it shows is taken into Web
/// Mercator first (its edges and points between them).
public fn tilesFor(_ m: Map, layer: Layer, limit: Int = 64) -> [Tile] {
    let seen = m.visible()
    if seen.empty || !(seen.width() > 0.0) || !(seen.height() > 0.0) {
        return []
    }
    var z = tileZoom(m, layer)
    let lo = max(layer.minZoom, 0)
    if isWebMercator(m.crs) {
        while true {
            let tiles = tilesIn(seen, zoom: z, limit: limit)
            if !tiles.isEmpty || z <= lo {
                return tiles
            }
            z -= 1
        }
    }
    // The view's points in Web Mercator.
    let mercator = webMercator()
    var xs: [Float] = []
    var ys: [Float] = []
    let steps = 16
    for a in 0..(steps + 1) {
        for b in 0..(steps + 1) {
            let x = seen.minX + seen.width() * Float(a) / Float(steps)
            let y = seen.minY + seen.height() * Float(b) / Float(steps)
            let (mx, my) = geodesy.transform(x, y, from: m.crs, to: mercator)
            if mx.isFinite && my.isFinite {
                xs.append(mx)
                ys.append(my)
            }
        }
    }
    if xs.isEmpty {
        return []
    }
    let (rx, _) = geodesy.transform(m.vp.centerX, m.vp.centerY, from: m.crs, to: mercator)
    while true {
        let tiles = tilesAround(xs, ys, rx, zoom: z, limit: limit)
        if !tiles.isEmpty || z <= lo {
            return tiles
        }
        z -= 1
    }
    []
}

// The tiles around Web Mercator points, the points' columns taken round
// the world to be near that of `refX` (so a view across the 180° meridian
// gets tiles on both sides of it).
private fn tilesAround(_ xs: [Float], _ ys: [Float], _ refX: Float, zoom: Int, limit: Int) -> [Tile] {
    let n = tileCount(zoom)
    let ref = if refX.isFinite { tileUnitsOf(x: refX, y: 0.0, zoom: zoom).0 } else { n / 2.0 }
    var x0 = 1.0 / 0.0
    var x1 = -1.0 / 0.0
    var y0 = 1.0 / 0.0
    var y1 = -1.0 / 0.0
    for i in 0..xs.count {
        var (tx, ty) = tileUnitsOf(x: xs[i], y: ys[i], zoom: zoom)
        tx = tileUnwrap(tx, ref, n)
        x0 = min(x0, tx)
        x1 = max(x1, tx)
        y0 = min(y0, ty)
        y1 = max(y1, ty)
    }
    tileRange(x0, y0, x1, y1, zoom: zoom, limit: limit)
}

// A column (in tile units) taken whole worlds round to be nearest `ref`.
fn tileUnwrap(_ tx: Float, _ ref: Float, _ n: Float) -> Float {
    tx + n * round((ref - tx) / n)
}

/// Is a system Web Mercator (the system tiles are in)?
public fn isWebMercator(_ crs: geodesy.Crs) -> Bool {
    crs.code == 3857 || crs.code == 900913 || crs.code == 3785 || sameCrs(crs, webMercator())
}

// ----- addresses -----

/// A tile's address: `template` with these filled in:
///
/// - `{z}`, `{x}`, `{y}`: the tile's zoom, column and row;
/// - `{-y}`: the row counted from the bottom (TMS);
/// - `{s}`: a server's name, a, b or c (the same for the same tile);
/// - `{q}`: the tile's quadkey;
/// - `{bbox}`: the tile's box in Web Mercator, "minX,minY,maxX,maxY" (the
///   tiles of a WMS, see `wmsTemplate`);
/// - `{r}`: nothing (where some servers take "@2x" for sharper tiles).
public fn tileUrl(_ template: String, _ t: Tile) -> String {
    var out = template
    if out.contains("\{bbox}") {
        let b = Tile(z: t.z, x: t.x, y: t.y, column: t.x).box()
        out = out.replace("\{bbox}", with: "{tileNumber(b.minX)},{tileNumber(b.minY)},{tileNumber(b.maxX)},{tileNumber(b.maxY)}")
    }
    if out.contains("\{q}") {
        out = out.replace("\{q}", with: t.quadkey())
    }
    if out.contains("\{-y}") {
        out = out.replace("\{-y}", with: "{t.tmsY()}")
    }
    let servers = ["a", "b", "c"]
    out
        .replace("\{z}", with: "{t.z}")
        .replace("\{x}", with: "{t.x}")
        .replace("\{y}", with: "{t.y}")
        .replace("\{s}", with: servers[(t.x + t.y) % 3])
        .replace("\{r}", with: "")
}

// A number for an address: plain digits, to the millimeter.
private fn tileNumber(_ v: Float) -> String {
    let r = round(v * 1000.0) / 1000.0
    if r == floor(r) && abs(r) < 1000000000000000.0 {
        return "{Int(r)}"
    }
    "{r}"
}

// ----- sources -----

/// Where a basemap's tiles come from: their address (see `tileUrl`), the
/// zooms there are tiles for, and the credit the map must show for them.
public struct TileSource {
    name: String = ""
    url: String = ""
    minZoom: Int = 0
    maxZoom: Int = 19
    attribution: String = ""
}

/// Basemaps anyone may use without a key, each with the credit its
/// provider asks for (their terms still apply: no bulk downloading, and
/// OpenStreetMap's servers are for light use; heavy users run their own
/// or pay a provider). OpenStreetMap's own tiles first. (CARTO's
/// basemaps aren't here: they now need an API key; give one with
/// `xyzLayer`.)
public fn tileSources() -> [TileSource] {
    let osm = "© OpenStreetMap contributors"
    let esri = "Tiles © Esri"
    [
        TileSource(name: "OpenStreetMap", url: "https://tile.openstreetmap.org/\{z}/\{x}/\{y}.png", maxZoom: 19, attribution: osm),
        TileSource(name: "OpenStreetMap HOT", url: "https://\{s}.tile.openstreetmap.fr/hot/\{z}/\{x}/\{y}.png", maxZoom: 19, attribution: osm + ", tiles style by Humanitarian OpenStreetMap Team hosted by OpenStreetMap France"),
        TileSource(name: "OpenTopoMap", url: "https://\{s}.tile.opentopomap.org/\{z}/\{x}/\{y}.png", maxZoom: 17, attribution: "Map data: " + osm + ", SRTM | Map style: © OpenTopoMap (CC-BY-SA)"),
        TileSource(name: "Esri World Imagery", url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/\{z}/\{y}/\{x}", maxZoom: 19, attribution: esri + " — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community"),
        TileSource(name: "Esri World Street Map", url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/\{z}/\{y}/\{x}", maxZoom: 19, attribution: esri + " — Source: Esri, DeLorme, NAVTEQ, USGS, Intermap, iPC, NRCAN, Esri Japan, METI, Esri China (Hong Kong), Esri (Thailand), TomTom, 2012"),
        TileSource(name: "Esri World Topo Map", url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/\{z}/\{y}/\{x}", maxZoom: 19, attribution: esri + " — Esri, DeLorme, NAVTEQ, TomTom, Intermap, iPC, USGS, FAO, NPS, NRCAN, GeoBase, Kadaster NL, Ordnance Survey, Esri Japan, METI, Esri China (Hong Kong), and the GIS User Community"),
        TileSource(name: "USGS Topo", url: "https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/\{z}/\{y}/\{x}", maxZoom: 16, attribution: "Tiles courtesy of the U.S. Geological Survey"),
        TileSource(name: "USGS Imagery", url: "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/\{z}/\{y}/\{x}", maxZoom: 16, attribution: "Tiles courtesy of the U.S. Geological Survey"),
    ]
}

/// The source called `named` in `tileSources()` (whatever its capitals),
/// or nil.
public fn tileSource(named: String) -> TileSource? {
    let lower = named.lowercase()
    for s in tileSources() {
        if s.name.lowercase() == lower {
            return s
        }
    }
    nil
}

/// A tile layer of a source's tiles, ready for `Map.add`.
public fn tileLayer(_ s: TileSource) -> Layer {
    Layer(name: s.name, kind: .tiles, source: s.url, crs: webMercator(), urlTemplate: s.url, minZoom: s.minZoom, maxZoom: s.maxZoom, attribution: s.attribution)
}

/// OpenStreetMap's standard map, the basemap most maps start with.
public fn openStreetMap() -> Layer {
    tileLayer(tileSources()[0])
}

/// A tile layer of any XYZ tile server: `url` with {z}, {x} and {y} where
/// a tile's numbers go (and the others `tileUrl` fills in). Give the
/// credit its provider asks for as `attribution`.
public fn xyzLayer(url: String, name: String = "Tiles", attribution: String = "", minZoom: Int = 0, maxZoom: Int = 19) -> Layer {
    tileLayer(TileSource(name: name, url: url, minZoom: minZoom, maxZoom: maxZoom, attribution: attribution))
}

/// The address of the tiles of a WMS (a Web Map Service, as GeoServer,
/// MapServer and QGIS Server give): GetMap requests for 256-pixel squares
/// in Web Mercator. `service` is the address of the service (what it
/// already asks is kept, unless it's one of the WMS's own words, which
/// are asked again), `layers` the names of its layers (comma-separated).
public fn wmsTemplate(service: String, layers: String, styles: String = "", format: String = "image/png", version: String = "1.1.1", transparent: Bool = true) -> String {
    var base = service.trim()
    if let q = base.find("?") {
        var kept: [String] = []
        for pair in base.substring(from: q + 1, to: base.count).split("&") {
            let key = (pair.split("=").first ?? "").lowercase()
            let own = ["service", "request", "version", "layers", "styles", "srs", "crs", "bbox", "width", "height", "format", "transparent"]
            if !pair.isEmpty && !own.contains(key) {
                kept.append(pair)
            }
        }
        base = base.substring(from: 0, to: q) + "?" + kept.joined(separator: "&") + (if kept.isEmpty { "" } else { "&" })
    } else {
        base = base + "?"
    }
    // (WMS 1.3.0 calls the system CRS; Web Mercator's axes are east, north
    // in both.)
    let system = if version.hasPrefix("1.3") { "CRS" } else { "SRS" }
    let clear = if transparent { "TRUE" } else { "FALSE" }
    "{base}SERVICE=WMS&VERSION={version}&REQUEST=GetMap&LAYERS={layers.trim().urlEncoded}&STYLES={styles.urlEncoded}&{system}=EPSG:3857&BBOX=\{bbox}&WIDTH=256&HEIGHT=256&FORMAT={format.urlEncoded}&TRANSPARENT={clear}"
}

/// A tile layer of a WMS's layers (see `wmsTemplate`).
public fn wmsLayer(service: String, layers: String, name: String = "", attribution: String = "", styles: String = "", format: String = "image/png", version: String = "1.1.1", transparent: Bool = true, minZoom: Int = 0, maxZoom: Int = 20) -> Layer {
    let url = wmsTemplate(service: service, layers: layers, styles: styles, format: format, version: version, transparent: transparent)
    let title = if name.isEmpty { layers } else { name }
    tileLayer(TileSource(name: title, url: url, minZoom: minZoom, maxZoom: maxZoom, attribution: attribution))
}

/// The layers a WMS says it has, from the text of its GetCapabilities
/// answer: each one's name and title.
public fn wmsLayerNames(_ capabilities: String) -> [(String, String)] {
    var out: [(String, String)] = []
    var seen: Set<String> = []
    let pieces = capabilities.split("<Layer")
    for (n, piece) in pieces.enumerated() {
        if n == 0 {
            continue
        }
        // Only what this layer itself says, before its own child layers.
        let name = tileTextBetween(piece, "<Name>", "</Name>")
        if !name.isEmpty && !seen.contains(name) {
            seen.insert(name)
            out.append((name, tileTextBetween(piece, "<Title>", "</Title>")))
        }
    }
    out
}

private fn tileTextBetween(_ text: String, _ start: String, _ end: String) -> String {
    if let a = text.find(start) {
        let rest = text.substring(from: a + start.count, to: min(text.count, a + start.count + 400))
        if let b = rest.find(end) {
            return rest.substring(from: 0, to: b).replace("<![CDATA[", with: "").replace("]]>", with: "").trim()
        }
    }
    ""
}
