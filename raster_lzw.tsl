// cartography: rasters, the byte-level packings of TIFF that the runtime
// doesn't have: LZW (read and written) and PackBits (read). Ported from
// Meridian's raster/lzw.tsl.
//
// Author: Alexius Academia
// Date: 2026-11-22

/// 2 to the power 0…24.
fn rasLzwPowers() -> [Int] {
    [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576,
     2097152, 4194304, 8388608, 16777216]
}

/// Whether LZW data is of the kind very old programs wrote (codes with
/// their bits the other way round), which this decoder doesn't read.
fn rasLzwIsOldStyle(_ d: Data, from: Int, to: Int) -> Bool {
    to - from >= 2 && d[from] == 0 && d[from + 1] % 2 == 1
}

/// The bytes that TIFF's LZW made the bytes `from` up to `to` of `d` from:
/// codes of 9 to 12 bits, most significant bit first, 256 clears the table
/// and 257 ends the data. A code gets one bit wider one code early (when
/// the table has 511, 1023 or 2047 entries), as every TIFF writer does.
/// Stops after `expected` bytes; damaged data gives fewer.
fn rasLzwDecode(_ d: Data, from: Int, to: Int, expected: Int) -> [Int] {
    let powers = rasLzwPowers()
    var out: [Int] = []
    // Every entry of the table is a run of bytes that is in `out` already:
    // where it starts, and how long it is.
    var starts: [Int] = []
    var lengths: [Int] = []
    for _ in 0..4096 {
        starts.append(0)
        lengths.append(0)
    }
    var next = 258
    var width = 9
    var limit = 511
    var acc = 0
    var bits = 0
    var pos = from
    var prevStart = -1
    var prevLength = 0
    while out.count < expected {
        while bits < width && pos < to {
            acc = acc * 256 + d[pos]
            pos += 1
            bits += 8
        }
        if bits < width {
            break
        }
        let shift = powers[bits - width]
        let code = acc / shift
        acc = acc % shift
        bits -= width
        if code == 256 {
            next = 258
            width = 9
            limit = 511
            prevStart = -1
            continue
        }
        if code == 257 {
            break
        }
        let start = out.count
        if prevStart < 0 {
            // The first code after a clear is always a plain byte.
            if code > 255 {
                break
            }
            out.append(code)
            prevStart = start
            prevLength = 1
            continue
        }
        var length = 1
        if code < 256 {
            out.append(code)
        } else if code < next {
            let s = starts[code]
            length = lengths[code]
            var i = 0
            while i < length {
                out.append(out[s + i])
                i += 1
            }
        } else if code == next {
            // The entry being made right now: the run before, and its
            // first byte again.
            length = prevLength + 1
            var i = 0
            while i < prevLength {
                out.append(out[prevStart + i])
                i += 1
            }
            out.append(out[prevStart])
        } else {
            break
        }
        // The new entry is the run before plus the first byte of this one,
        // which is what follows it in `out`.
        if next < 4096 {
            starts[next] = prevStart
            lengths[next] = prevLength + 1
            next += 1
            if next >= limit && width < 12 {
                width += 1
                limit = powers[width] - 1
            }
        }
        prevStart = start
        prevLength = length
    }
    out
}

/// Bytes packed with TIFF's LZW (see `rasLzwDecode`), as libtiff writes it.
fn rasLzwEncode(_ bytes: [Int]) -> [Int] {
    let powers = rasLzwPowers()
    var out: [Int] = []
    var acc = 0
    var bits = 0
    var width = 9
    var next = 258
    var table: [Int: Int] = [:]
    let n = bytes.count
    // A clear code first.
    acc = 256
    bits = 9
    var current = -1
    var i = 0
    while i <= n {
        var emit = -1
        var clear = false
        if i < n {
            let b = bytes[i]
            if current < 0 {
                current = b
            } else if let found = table[current * 256 + b] {
                current = found
            } else {
                emit = current
                table[current * 256 + b] = next
                next += 1
                current = b
                clear = next == 4094
            }
        } else {
            // The last run. A reader makes a table entry after it too, so
            // the end code may have to be a bit wider.
            emit = current
            next += 1
        }
        i += 1
        if emit < 0 {
            continue
        }
        acc = acc * powers[width] + emit
        bits += width
        while bits >= 8 {
            let shift = powers[bits - 8]
            out.append(acc / shift)
            acc = acc % shift
            bits -= 8
        }
        if clear {
            acc = acc * powers[width] + 256
            bits += width
            while bits >= 8 {
                let shift = powers[bits - 8]
                out.append(acc / shift)
                acc = acc % shift
                bits -= 8
            }
            table = [:]
            next = 258
            width = 9
        } else if next > powers[width] - 1 && width < 12 {
            width += 1
        }
    }
    // The end code, and what is left of the last byte.
    acc = acc * powers[width] + 257
    bits += width
    while bits >= 8 {
        let shift = powers[bits - 8]
        out.append(acc / shift)
        acc = acc % shift
        bits -= 8
    }
    if bits > 0 {
        out.append(acc * powers[8 - bits])
    }
    out
}

/// The bytes that PackBits made the bytes `from` up to `to` of `d` from: a
/// count byte n, then n + 1 bytes as they are (n from 0 to 127) or one
/// byte to repeat 1 - n times (n from -1 to -127).
fn rasUnpackBits(_ d: Data, from: Int, to: Int, expected: Int) -> [Int] {
    var out: [Int] = []
    var pos = from
    while pos < to && out.count < expected {
        let n = d[pos]
        pos += 1
        if n < 128 {
            var k = 0
            while k <= n && pos < to {
                out.append(d[pos])
                pos += 1
                k += 1
            }
        } else if n > 128 {
            if pos >= to {
                break
            }
            let b = d[pos]
            pos += 1
            var k = 0
            while k < 257 - n {
                out.append(b)
                k += 1
            }
        }
    }
    out
}
